PORT=4000

# Project Settings > API in your Supabase dashboard
SUPABASE_URL=https://your-project.supabase.co
# The "anon" public key — safe to also use client-side
SUPABASE_ANON_KEY=your-anon-key
# The "service_role" secret key — NEVER expose this to the frontend or commit it.
# It bypasses Row Level Security entirely; it must only ever live here, on the server.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your deployed frontend URL (comma-separate if you have more than one)
CORS_ORIGIN=http://localhost:5173
